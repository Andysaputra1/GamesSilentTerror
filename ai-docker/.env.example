# Salin jadi .env, atau biarkan jalankan.bat membuatnya otomatis (token acak 64 karakter).
# LLM_TOKEN dikirim ke backend (Konfigurasi AI panel) otomatis oleh jalankan.bat.
LLM_TOKEN=
# Model yang disiapkan (dipisah spasi); yang dipakai bot dipilih di panel > Otak NPC > Model LLM link.
# qwen3:4b-instruct = cepat (tanpa mode berpikir); qwen3:14b = lebih pintar, lebih lambat di GPU 6 GB.
LLM_MODELS=qwen3:4b-instruct qwen3:14b
# Opsional:
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
