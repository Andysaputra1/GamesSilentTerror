# Salin jadi .env, atau biarkan jalankan.bat membuatnya otomatis (token acak 64 karakter).
# LLM_TOKEN harus sama dengan OLLAMA_TUNNEL_TOKEN di .env.azure VM.
LLM_TOKEN=
# Qwen3 4B versi instruct (tanpa mode berpikir) supaya kalimat bot cepat.
LLM_MODEL=qwen3:4b-instruct
# Opsional:
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
