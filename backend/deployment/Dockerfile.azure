FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./requirements.txt
# PyTorch versi CPU untuk IndoBERT (VM tanpa GPU): wheel bawaan PyPI membawa CUDA berukuran beberapa GB.
# Versinya sama dengan requirements.txt agar langkah berikutnya tidak menggantinya.
RUN pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser . .
USER appuser
EXPOSE 8000
# One worker: room engine, Google nonces, and AI overrides live in one process.
# Proxy headers: IP pemain berasal dari X-Forwarded-For yang ditulis Caddy (Caddy membuang header kiriman
# klien). Aman karena port backend tidak dibuka ke luar; tanpa ini semua pemain terlihat sebagai IP Caddy
# dan berbagi satu batas percobaan login.
CMD ["uvicorn", "main:asgi_app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
