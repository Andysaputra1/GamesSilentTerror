# Salin file ini menjadi .env bila ingin mengganti kredensial development.
MYSQL_USER=shadow_app
MYSQL_PASSWORD=shadow_app_dev_2026
MYSQL_ROOT_PASSWORD=shadow_root_dev_2026
PMA_ABSOLUTE_URI=http://localhost:8000/phpmyadmin/

# Keep this secret only in the local .env / deployment secret store. Never put
# an actual key in Git or in Angular code.
OPENAI_API_KEY=
AI_PROVIDER=docker
# docker-compose.yml = Ollama CPU; docker-compose.gpu.yml = Ollama NVIDIA.
# Mode API: isi AI_PROVIDER=api dan key, jalankan hanya service aplikasi (lihat README).
# 8 selects qwen3:8b; 14 selects qwen3:14b.
OLLAMA_MODEL=8
OLLAMA_TIMEOUT_SECONDS=180
# Untuk CPU yang lambat, bisa dinaikkan misalnya 600; RAM tetap harus cukup.
OLLAMA_MAX_OUTPUT_TOKENS=160
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=320
AUTH_SESSION_HOURS=24
APP_ENVIRONMENT=development
# Panel development /admin: daftar username admin, dipisahkan koma.
ADMIN_USERNAMES=user1
# OAuth Web Client ID (public). Google Identity Services does not need a client secret.
GOOGLE_CLIENT_ID=

# Local Ollama server. Model files persist in Docker volume games_ollama_data.
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_KEEP_ALIVE=10m
# Unduh 8B saja untuk setup awal. Tambahkan qwen3:14b bila memang akan dipakai.
OLLAMA_MODELS_TO_PULL=qwen3:8b

# Akun yang sudah terdaftar dan boleh membaca seluruh arsip percakapan.
HISTORY_ADMIN_USERNAMES=

# Unified /panel. Generate the hash using backend/scripts/setup_panel.py.
PANEL_USERNAME=administrator
PANEL_PASSWORD_HASH=
OPENROUTER_API_KEY=
API_BACKEND=openrouter
# Optional Authorization Bearer token for your Ollama tunnel proxy.
OLLAMA_TUNNEL_TOKEN=

# Generated once by setup_panel.py; preserve this key to decrypt saved API keys.
PANEL_ENCRYPTION_KEY=

# Key OpenRouter bawaan server untuk pilihan Default di panel.
openrouter_default=

# Otak NPC (NLU IndoBERT -> fuzzy/utility/behavior tree -> NLG), hasil notebook skripsi.
# NPC_METHOD: campuran | fuzzy | utility | bt | llm (llm = mode lama, pembanding).
NPC_METHOD=campuran
# NPC_WRITER: otomatis (rantai penulis LLM, semua gagal -> templat) | templat (tanpa LLM).
NPC_WRITER=otomatis
# Prioritas awal rantai penulis (urutan dan jalur aktif bisa diubah di panel Otak NPC):
# claude_bedrock (AMAZON_API_KEY), claude_api (ANTHROPIC_API_KEY), openrouter (key OpenRouter di atas/panel),
# tautan (LLM sendiri lewat URL tunnel di panel Konfigurasi AI, mis. Ollama di Docker). Jalur tanpa key dilewati.
NPC_WRITER_ORDER=claude_bedrock,claude_api,openrouter,tautan
# Model OpenRouter untuk penulis kalimat; kosong = anthropic/claude-opus-5.5 (Claude yang sama dengan notebook).
NPC_OPENROUTER_MODEL=
NPC_VALIDATE_NLG=true
NPC_NLU_DEVICE=cpu
# Jeda antarlangkah otak tiap bot (detik, 1-30).
NPC_STEP_SECONDS=3
# Opsional: lokasi model bila tidak di backend/artifacts/indobert/{intent,target}.
NPC_INTENT_MODEL_DIR=
NPC_TARGET_MODEL_DIR=
# Key Claude untuk rantai penulis (opsional; tanpa key jalur itu dilewati).
ANTHROPIC_API_KEY=
# Bedrock API key untuk Claude di Amazon Bedrock.
AMAZON_API_KEY=
# Region Bedrock (bentuk region AWS, mis. us-east-1).
NPC_BEDROCK_REGION=us-east-1
